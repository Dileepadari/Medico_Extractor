# Copy to `.env` and fill in. Never commit the real file.
# Every variable below is optional except GOOGLE_API_KEY.

# --- Model credentials -------------------------------------------------
# Required. Get one from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model used for extraction, and how it is called.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.0
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2

# --- Environment -------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# json (machine-readable, default) | console (readable locally)
LOG_FORMAT=console

# --- HTTP --------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated allowed origins. Set explicit origins in production.
CORS_ORIGINS=*
# Serve the bundled web UI from "/". Set false for an API-only deployment.
SERVE_FRONTEND=true
# Expose /docs and /openapi.json. Defaults to true outside production.
# ENABLE_DOCS=true
# Set when the app is mounted under a path prefix by a proxy, e.g. /api.
ROOT_PATH=

# --- Upload limits -----------------------------------------------------
# 10 MiB. Raise with care: the whole file is held in memory and base64-encoded.
MAX_UPLOAD_BYTES=10485760
ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png,image/webp

# --- Access control ----------------------------------------------------
# When set, POST /extract requires a matching X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Per-client-IP budget for /extract. Set RATE_LIMIT_REQUESTS=0 to disable.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
